# این متغیرها را در تنظیمات پروژه‌ی Vercel (Project Settings → Environment Variables) وارد کنید.
# فایل .env واقعی هرگز نباید commit شود (در .gitignore هست).

# اتصال به Supabase (PostgreSQL واقعی) — اگر خالی باشند، سایت از فایل محلی data/db.json
# استفاده می‌کند (مناسب توسعه، ولی روی Vercel چون فایل‌سیستم فقط-خواندنی است حتماً باید ست شوند)
SUPABASE_URL=https://xxxxxxxxxx.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# رشته‌ی تصادفی و طولانی برای امضای JWT — حتماً برای پروداکشن مقدار واقعی بگذارید
JWT_SECRET=change-this-to-a-long-random-string

# تنظیمات SMTP برای ارسال کد تایید ایمیلی (OTP)
# اگر خالی بگذارید، سایت در "حالت آزمایشی" کار می‌کند و کد را در پاسخ API نشان می‌دهد
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
